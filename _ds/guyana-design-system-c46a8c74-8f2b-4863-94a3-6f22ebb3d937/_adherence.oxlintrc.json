      {
        "selector": "JSXOpeningElement[name.name='FieldLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:htmlFor|label|required|hint|error|key|ref|className|style|children)$/]",
        "message": "<FieldLabel> doesn't accept that prop. Declared props: htmlFor, label, required, hint, error."
      },
