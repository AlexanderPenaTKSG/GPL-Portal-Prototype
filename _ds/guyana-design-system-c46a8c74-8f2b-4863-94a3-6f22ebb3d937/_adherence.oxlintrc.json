        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|count|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, icon, count."
      },
